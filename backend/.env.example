# Server
PORT=5000
NODE_ENV=development

# Public URL of this backend (used to build tracking / survey links)
PUBLIC_BASE_URL=http://localhost:5000

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/campaign_db

# JWT
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Key used to encrypt provider credentials stored in DB (32+ chars)
SETTINGS_ENCRYPTION_KEY=change-this-to-a-long-random-32-char-key

# CORS (comma separated origins, * for all)
CORS_ORIGIN=http://localhost:5001

# NOTE: the first super admin is created automatically in the database
# (default login: admin@example.com / Admin@12345 — change it after first login).
# These are optional overrides only:
# SUPER_ADMIN_NAME=Super Admin
# SUPER_ADMIN_EMAIL=admin@example.com
# SUPER_ADMIN_PASSWORD=Admin@12345

# Sending engine
SEND_DELAY_MS=250
MAX_CONCURRENT_CAMPAIGNS=2
MAX_SEND_RETRIES=2
RETRY_BACKOFF_MS=3000
SCHEDULER_INTERVAL_MS=30000

# Initial super admin (created by `npm run seed`)
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=Admin@12345
